pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source repository...'
            }
        }
        stage('Execute Hello World') {
            steps {
                sh 'chmod +x hello-world.sh'
                sh './hello-world.sh'
            }
        }
    }
    post {
        success {
            echo 'Hello World job completed successfully!'
        }
    }
}
